+        return dict(self._get(identity)['bios'])
+
+    def set_bios(self, identity, attributes):
+        bios = self.get_bios(identity)
+        bios.update({k: str(v) for k, v in attributes.items()})
+        self._update(identity, bios=bios)
+
+    def reset_bios(self, identity):
+        self._update(identity, bios=dict(self._config.get(
+            'SUSHY_EMULATOR_FAKE_BIOS', {'BootMode': 'Uefi'})))
