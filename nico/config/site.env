# Single source of truth for the NiCo install scripts and value templates.
# Copy to site.env (this file IS the file the scripts read) and edit every CHANGE ME.
# Addresses below are RFC 5737 documentation ranges; nothing here matches a real lab.

# --- cluster access -----------------------------------------------------------
REMOTE_KUBECONFIG=${HOME}/.kube/config          # kubeconfig for the cluster that will run NiCo
SSH_USER=ubuntu                                  # unused by the NiCo scripts; kept for lib.sh
API_PORT=6443

# --- namespaces (nico-system / nico-rest are hardcoded in NiCo's charts) -----
CERT_MANAGER_NS=cert-manager                     # an existing cert-manager install
PLATFORM_NS=vcluster-platform                    # where vCluster Platform runs (for nico-trust.sh)
METALLB_NS=kube-system                           # see LB notes in README: MetalLB or Cilium
PROJECT_NS=p-default
NICO_SYSTEM_NS=nico-system
NICO_REST_NS=nico-rest
KEYCLOAK_CLIENT_SECRET=nico-local-secret         # bundled Keycloak, only until nico-trust.sh

# --- versions / images ---------------------------------------------------------
NICO_VERSION=v2.1.0-rc.8                         # upstream NVIDIA/infra-controller tag
# NVIDIA publishes no images; these are the mirror the vCluster NiCo integration was built against.
NICO_IMAGE_REGISTRY=ghcr.io/janekbaraniewski
NICO_CORE_IMAGE_NAME=nvmetal-carbide

# --- storage / load balancer -----------------------------------------------------
NICO_STORAGE_CLASS=CHANGE-ME                     # a Retain-capable StorageClass (Longhorn, local-path-persistent ...)
# Cilium LB-IPAM: the node that will announce NiCo's VIPs and run nico-api/pxe/dhcp (see README "Cilium").
# MetalLB: leave NICO_EDGE_NODE empty and set LB_MODE=metallb.
LB_MODE=cilium                                   # cilium | metallb
NICO_EDGE_NODE=CHANGE-ME                         # kubernetes.io/hostname of one amd64 node (cilium mode)
L2_INTERFACE=CHANGE-ME                           # NIC the L2 announcements go out of (cilium mode), e.g. eth0

# --- networks --------------------------------------------------------------------
# HostInband = the L2 segment your VMs' NICs sit on (host bridge on the sushy host + your switch).
HOSTINBAND_CIDR=192.0.2.0/24
HOSTINBAND_NET=192.0.2
HOSTINBAND_GW=192.0.2.1
HOSTINBAND_RESERVE_FIRST=50                      # NiCo hands out .50 and up; keep static hosts below
RELAY_IP=192.0.2.4                               # address the DHCP relay (sushy host) puts on the bridge
METAL3_DHCP_VIP=192.0.2.2                        # only if a Metal3 dhcp-proxy shares the segment; else any free IP
# BMC / "underlay" segment: where the per-VM sushy instances listen (usually your management LAN).
OOB_PREFIX=198.51.100.0/24
OOB_GW=198.51.100.1
# NiCo service VIPs, from your LoadBalancer pool (10 addresses). Kea (DHCP) and PXE must be routable from the VMs.
NICO_METALLB_INTERNAL=198.51.100.236-198.51.100.244
NICO_METALLB_EXTERNAL=198.51.100.245-198.51.100.245
NICO_VIP_DHCP=198.51.100.236
NICO_VIP_DNS_0=198.51.100.237
NICO_VIP_DNS_1=198.51.100.238
NICO_VIP_PXE=198.51.100.239
NICO_VIP_NTP_0=198.51.100.240
NICO_VIP_NTP_1=198.51.100.241
NICO_VIP_NTP_2=198.51.100.242
NICO_VIP_SSH_CONSOLE=198.51.100.243
NICO_VIP_UNBOUND=198.51.100.244
NICO_VIP_API=198.51.100.245
# Kea answers only NiCo machines: a client-class test on the VM MAC prefix. Byte index is 0-based.
# Example: VMs with MACs 52:54:00:bb:00:0N -> byte 3 == 0xbb
NICO_MAC_CLASS_TEST='substring(pkt4.mac,3,1) == 0xbb'

# --- machines --------------------------------------------------------------------
# Names must match the libvirt domain names and sushy-tools/vms.conf.
NICO_VMS=2
NICO_VM_PREFIX=nico-vm
NICO_BMC_IPS="198.51.100.202 198.51.100.203"     # one per VM, in order: the sushy-nico listen addresses
NICO_DATA_MAC_PREFIX=52:54:00:BB:00              # VM NIC MACs are <prefix>:00, :01, ... (zero-based)
NICO_BMC_MAC_PREFIX=02:00:00:00:0B               # synthetic BMC MACs <prefix>:01, :02, ... (must not collide)
NICO_SERIAL_PREFIX=NICO-VM-                      # chassis serial = <prefix><N>, also set in libvirt SMBIOS
BMC_USERNAME=admin                               # sushy-tools htpasswd credentials
BMC_PASSWORD=password

# --- NiCo site identity ----------------------------------------------------------
NICO_SITE_NAME=lab
NICO_SITE_DOMAIN=lab.nico
NICO_ORG=ncx                                     # provider org; the Platform Tenant org must differ
NICO_REST_PORT=8388
